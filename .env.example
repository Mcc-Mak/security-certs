# CI/CD secrets — consumed by .github/workflows/ci-cd.yml and
# scripts/configure-secrets.sh.
#
# Copy to .env (gitignored), fill in real values, then run:
#
#   ./scripts/configure-secrets.sh
#
# The script pushes each value into GitHub's encrypted secret store via `gh`,
# enables GitHub Pages (Source = GitHub Actions), and registers `dev-001` as a
# deployment branch for the github-pages environment. Never commit the real
# .env — it is gitignored. GitHub-hosted runners cannot read this file at
# runtime; they only see repository secrets.

# ── Tokens ──────────────────────────────────────────────────────────────────

# GitHub PAT used by the wiki job to push docbase/ engineering docs
# to the GitHub Wiki (separate .wiki.git repo). The promote job uses GITHUB_TOKEN
# (built-in) for direct pushes to dev and main, so no PAT is needed for promotion.
# Scopes: repo
PROMOTE_TOKEN=

# SonarQube Cloud analysis token. Create at:
#   SonarCloud → My Account → Security → Generate Tokens
# Used by the security_checks job (pre-promotion gate) for SCA + quality gate,
# and by the sonar_baseline job (informational main-branch scan).
# Optional — when absent, the security_checks job is skipped (with a notice).
SONAR_TOKEN=
